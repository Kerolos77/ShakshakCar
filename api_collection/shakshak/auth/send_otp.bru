meta {
  name: send_otp
  type: http
  seq: 1
}

post {
  url: {{url}}/auth/send_otp
  body: multipart-form
  auth: inherit
}

body:multipart-form {
  phone: {{phone}}
}

script:post-response {
  const axios = require('axios');
  if (res.status === 200) {
    const baseUrl = bru.getVar('url') || 'http://127.0.0.1:8000/api/v1';
    axios.get(`${baseUrl}/auth/verify_otp?code=111111`)
      .then(response => {
        const resData = response.data?.data || response.data;
        const token = resData?.token || resData?.access_token;
        const isDriver = resData && (resData.is_driver == 1 || resData.is_driver === true);

        if (token) {
          if (isDriver) {
            bru.setVar("tokenDriver", token);
            try { bru.setEnvVar("tokenDriver", token); } catch(e){}
            console.log("✅ Driver Token Saved Automatically:", token);
          } else {
            bru.setVar("tokenUser", token);
            try { bru.setEnvVar("tokenUser", token); } catch(e){}
            console.log("✅ User Token Saved Automatically:", token);
          }
        }
      })
      .catch(err => {
        console.log("❌ Verify OTP failed in script:", err.message);
      });
  }
}
