meta {
  name: 2. Verify OTP Standalone
  type: http
  seq: 2
}

get {
  url: {{url}}/auth/verify_otp?code=111111
  body: none
  auth: inherit
}

params:query {
  code: 111111
}

script:post-response {
  try {
    if (res.status === 200) {
      const resData = res.body?.data || res.body;
      const token = resData?.token || resData?.access_token || res.body?.token;
      const isDriver = resData && (resData.is_driver == 1 || resData.is_driver === true);

      if (token) {
        if (isDriver) {
          bru.setVar("tokenDriver", token);
          try { bru.setEnvVar("tokenDriver", token); } catch (e) {}
          console.log("✅ Driver Token saved successfully:", token);
        } else {
          bru.setVar("tokenUser", token);
          try { bru.setEnvVar("tokenUser", token); } catch (e) {}
          console.log("✅ User Token saved successfully:", token);
        }
      } else {
        console.log("⚠️ Token not found in response:", res.body);
      }
    }
  } catch (err) {
    console.log("❌ Script execution error:", err);
  }
}
